# Kopie als .env anlegen. Die Installer erzeugen die Geheimnisse selbst.
PANEL_IMAGE=ghcr.io/brogameryt/nxpanel:latest
PANEL_PORT=8080
PANEL_URL=http://localhost:8080

POSTGRES_DB=panel
POSTGRES_USER=panel
POSTGRES_PASSWORD=

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
ENCRYPTION_KEY=

# Portbereich fuer die Gameserver (TCP und UDP)
PORT_RANGE=25500-25600
TZ=Europe/Berlin

# IO-Gewichtung pro Container. Unter Docker Desktop/WSL2 nicht verfuegbar.
# Auf einem Linux-Host mit cgroup v2 kann sie eingeschaltet werden.
ENABLE_IO_WEIGHT=false

# DNS fuer Spielcontainer, kommagetrennt. Leer lassen = Resolver des Hosts.
# Nur setzen, wenn es einen guten Grund gibt - feste oeffentliche Server
# scheitern hinter VPNs und Pi-hole.
CONTAINER_DNS=
