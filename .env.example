# NexusPanel - Konfigurationsvorlage (.env)
# Erstelle eine Kopie dieser Datei als .env und passe die Werte an:
#   copy .env.example .env

PANEL_PORT=8080
PANEL_URL=http://localhost:8080

# Datenbank (PostgreSQL)
POSTGRES_DB=panel
POSTGRES_USER=panel
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgres://panel:change_this_password@127.0.0.1:5432/panel?sslmode=disable

# Cache & Live-Events (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Sicherheit (Generieren mit: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_32_byte_hex_string
ENCRYPTION_KEY=change_me_to_a_random_32_byte_hex_string

# Portbereich für Spielserver (TCP und UDP)
PORT_RANGE=25500-25600
TZ=Europe/Berlin

# Laufzeit & Pfade
NODE_ENV=development
LOG_LEVEL=debug
# Unter Windows: //./pipe/docker_engine | Unter Linux: /var/run/docker.sock
DOCKER_SOCKET=//./pipe/docker_engine
VOLUME_ROOT=./data/volumes
BACKUP_ROOT=./data/backups

ENABLE_IO_WEIGHT=false
