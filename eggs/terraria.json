{
  "_comment": "NexusPanel-Egg fuer Terraria (Vanilla oder tModLoader). Image passivelemon/terraria-docker, Einstellungen ueber Umgebungsvariablen, Welten und serverconfig unter /opt/terraria/config. UNGETESTET.",
  "name": "Terraria",
  "author": "nxpanel",
  "nest": "Survival",
  "cover": {
    "steam": 105600
  },
  "docker_images": {
    "Vanilla (passivelemon/terraria-docker)": "passivelemon/terraria-docker:terraria-latest",
    "tModLoader – Mods (passivelemon/terraria-docker)": "passivelemon/terraria-docker:tmodloader-latest"
  },
  "startup": "(Einstiegspunkt des Images)",
  "data_dir": "/opt/terraria/config",
  "console": "full",
  "stop": "exit",
  "ready_check": {
    "kind": "done",
    "regex": "Server started|Listening on port",
    "timeout_seconds": 900
  },
  "ports": {
    "primary": {
      "ref": "game",
      "name": "Spiel",
      "start": 7777,
      "end": 7876,
      "protocol": "tcp"
    }
  },
  "resources": {
    "base_ram_mb": 1024,
    "ram_per_player_mb": 64,
    "min_cpu_percent": 100,
    "disk_mb": 3000,
    "notes": "Vanilla mit bis zu 8 Spielern: 1-1,5 GB. tModLoader mit vielen Mods: 3-6 GB."
  },
  "variables": [
    {
      "name": "PORT",
      "name_locales": {
        "de": "PORT",
        "en": "PORT"
      },
      "env_variable": "PORT",
      "default_value": "{{SERVER_PORT}}",
      "rules": "nullable|string",
      "user_editable": false,
      "user_viewable": false
    },
    {
      "name": "Weltname",
      "name_locales": {
        "de": "Weltname",
        "en": "World Name"
      },
      "env_variable": "WORLDNAME",
      "description": "Gibt es die Welt noch nicht, wird sie angelegt.",
      "description_locales": {
        "de": "Gibt es die Welt noch nicht, wird sie angelegt.",
        "en": "Created if it does not exist."
      },
      "default_value": "Welt1",
      "rules": "required|string|max:32|regex:/^[A-Za-z0-9_-]+$/"
    },
    {
      "name": "Weltgröße (neue Welt)",
      "name_locales": {
        "de": "Weltgröße (neue Welt)",
        "en": "World Size (new world)"
      },
      "env_variable": "AUTOCREATE",
      "description": "1 klein, 2 mittel, 3 groß.",
      "description_locales": {
        "de": "1 klein, 2 mittel, 3 groß.",
        "en": "1 small, 2 medium, 3 large."
      },
      "default_value": "2",
      "rules": "required|in:1,2,3"
    },
    {
      "name": "Schwierigkeit (neue Welt)",
      "name_locales": {
        "de": "Schwierigkeit (neue Welt)",
        "en": "Difficulty (new world)"
      },
      "env_variable": "DIFFICULTY",
      "description": "0 Normal, 1 Experte, 2 Meister, 3 Reise.",
      "description_locales": {
        "de": "0 Normal, 1 Experte, 2 Meister, 3 Reise.",
        "en": "0 classic, 1 expert, 2 master, 3 journey."
      },
      "default_value": "0",
      "rules": "required|in:0,1,2,3"
    },
    {
      "name": "Weltsaat",
      "name_locales": {
        "de": "Weltsaat",
        "en": "World Seed"
      },
      "env_variable": "SEED",
      "description": "Nur für neue Welten.",
      "description_locales": {
        "de": "Nur für neue Welten.",
        "en": "Only for new worlds."
      },
      "default_value": "",
      "rules": "nullable|string|max:64"
    },
    {
      "name": "Maximale Spielerzahl",
      "name_locales": {
        "de": "Maximale Spielerzahl",
        "en": "Maximum Players"
      },
      "env_variable": "MAXPLAYERS",
      "default_value": "8",
      "rules": "required|numeric|between:1,255"
    },
    {
      "name": "Server-Passwort",
      "name_locales": {
        "de": "Server-Passwort",
        "en": "Server Password"
      },
      "env_variable": "PASSWORD",
      "description": "Leer = ohne Passwort.",
      "description_locales": {
        "de": "Leer = ohne Passwort.",
        "en": "Empty = no password."
      },
      "default_value": "",
      "rules": "nullable|string|max:64",
      "secret": true
    },
    {
      "name": "Willkommensnachricht",
      "name_locales": {
        "de": "Willkommensnachricht",
        "en": "Message of the Day"
      },
      "env_variable": "MOTD",
      "default_value": "Willkommen!",
      "rules": "nullable|string|max:200"
    },
    {
      "name": "Sprache",
      "name_locales": {
        "de": "Sprache",
        "en": "Language"
      },
      "env_variable": "LANGUAGE",
      "default_value": "de-DE",
      "rules": "required|in:en-US,de-DE,it-IT,fr-FR,es-ES,ru-RU,zh-Hans,pt-BR,pl-PL"
    },
    {
      "name": "tModLoader-Modpack",
      "name_locales": {
        "de": "tModLoader-Modpack",
        "en": "tModLoader Modpack"
      },
      "env_variable": "MODPACK",
      "description": "Nur mit dem tModLoader-Image: Name des Modpack-Ordners unter config.",
      "description_locales": {
        "de": "Nur mit dem tModLoader-Image: Name des Modpack-Ordners unter config.",
        "en": "Only with the tModLoader image: name of the modpack folder in config."
      },
      "default_value": "",
      "rules": "nullable|string|max:64"
    }
  ],
  "import": {
    "notes": "Uebernimmt den Ordner Worlds und eine eigene serverconfig.txt.",
    "rules": [
      {
        "match": "Worlds",
        "to": "Worlds"
      },
      {
        "match": "serverconfig.txt",
        "to": "serverconfig.txt"
      }
    ],
    "detect": {
      "markers": [
        "Worlds"
      ],
      "vars": [
        {
          "var": "WORLDNAME",
          "from": "filename",
          "pattern": "^(.+)\\.wld$"
        }
      ]
    }
  },
  "hints": [
    {
      "match": "Permission denied|UnauthorizedAccess",
      "flags": "i",
      "level": "error",
      "text": "Der Server darf den Datenordner nicht beschreiben.",
      "text_locales": {
        "de": "Der Server darf den Datenordner nicht beschreiben.",
        "en": "The server cannot write to the data folder."
      }
    }
  ],
  "windows": {
    "download": {
      "source": "terraria",
      "stripTop": true,
      "mkdirs": [
        "worlds"
      ]
    },
    "executable": "Windows/TerrariaServer.exe",
    "args": [
      "-port",
      "{{PORT_GAME}}",
      "-maxplayers",
      "{{MAXPLAYERS}}",
      "-worldpath",
      "worlds",
      "-world",
      "worlds/{{WORLDNAME}}.wld",
      "-autocreate",
      "{{AUTOCREATE}}",
      "-worldname",
      "{{WORLDNAME}}",
      "-difficulty",
      "{{DIFFICULTY}}",
      {
        "when": "SEED",
        "args": [
          "-seed",
          "{{SEED}}"
        ]
      },
      {
        "when": "PASSWORD",
        "args": [
          "-password",
          "{{PASSWORD}}"
        ]
      },
      {
        "when": "MOTD",
        "args": [
          "-motd",
          "{{MOTD}}"
        ]
      }
    ],
    "stop": {
      "timeout_seconds": 30
    }
  }
}