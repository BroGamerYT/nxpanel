# Betriebsart: test | production
NEXUSCORE_MODE=test

# HTTP-Server (ohne TLS; TLS kommt mit mTLS in M2)
NEXUSCORE_HOST=127.0.0.1
NEXUSCORE_PORT=8443

# Treiber: windows-native | docker | mock
NEXUSCORE_RUNTIME=windows-native

# Ablage fuer Registry und Logs (Standard: <Projekt>/data)
NEXUSCORE_DATA_DIR=./data

# Bearer-Token fuer alle geschuetzten Routen (in production Pflicht)
NEXUSCORE_TOKEN=

# Kopplungs-PIN (leer = beim Start zufaellig erzeugen und ausgeben)
NEXUSCORE_PAIRING_PIN=

# Erlaubte CORS-Herkuenfte, kommagetrennt (leer = CORS aus)
NEXUSCORE_CORS_ORIGINS=

# Zusaetzliche Hostnamen, unter denen der Core erreichbar sein darf, kommagetrennt
# (z. B. mein-pc.fritz.box). IP-Adressen und localhost sind immer erlaubt,
# alles andere wird als DNS-Rebinding abgelehnt.
NEXUSCORE_ALLOWED_HOSTS=

NEXUSCORE_LOG_LEVEL=info

# Nur fuer lokale Ersttests: erlaubt Zugriff ohne Token.
# In production wird das ignoriert.
NEXUSCORE_ALLOW_INSECURE_AUTH=false
