<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NexusCore Host Daemon" 
           Manufacturer="NexusPanel Team" 
           Version="$(CoreVersion)" 
           UpgradeCode="e38f6b01-5764-4e3a-92ea-df73cf763291" 
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von NexusCore ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NexusCore">
        <Directory Id="WebFolder" Name="web" />
        <Directory Id="EggsFolder" Name="eggs" />
        <Directory Id="DocsFolder" Name="docs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="NexusCore" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="NexusCoreExe" Guid="9a8e742a-1163-4482-bb34-8c01b44ec401">
        <File Id="NexusCoreExeFile" Source="nexuscore\dist\nexuscore.exe" KeyPath="yes" />
        <Shortcut Id="NexusCoreStartMenuShortcut" 
                  Directory="ApplicationProgramsFolder" 
                  Name="NexusCore Host Daemon" 
                  WorkingDirectory="INSTALLFOLDER" 
                  Advertise="yes" />
      </Component>
      <!-- Dienst-Huelle: startet den Core, startet ihn nach einem Absturz neu, beendet ihn sauber -->
      <Component Id="NexusCoreServiceHost" Guid="5c1d7a52-0b6e-4f3a-9d0a-7e2b1f4c8a10">
        <File Id="NxsvcExeFile" Source="nexuscore\helper\nxsvc\target\release\nxsvc.exe" KeyPath="yes" />
        <ServiceInstall Id="NexusCoreService"
                        Name="NexusCore"
                        DisplayName="NexusCore Host Daemon"
                        Description="NexusCore: verwaltet Spielserver auf diesem Rechner (Oberflaeche, Kopplung mit dem Panel)."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Arguments="service --name NexusCore --workdir &quot;[INSTALLFOLDER]\&quot; --log &quot;[CommonAppDataFolder]NexusCore\logs\core.log&quot; --grace 100 -- &quot;[INSTALLFOLDER]nexuscore.exe&quot;">
          <!-- ACHTUNG: [INSTALLFOLDER] endet mit \ - vor dem schliessenden Anfuehrungszeichen muss er verdoppelt werden (\\"), sonst gilt \" als
               Anfuehrungszeichen im Text und nxsvc meldet "Es fehlt das Programm" (Dienst startet nicht).
               Absturz des Cores faengt nxsvc selbst ab (Neustart nach 2 s, dann 4, 8 ... bis 60 s). Wiederherstellungsaktionen der Dienststeuerung
               fuer nxsvc selbst setzt scripts/install-service.ps1 (sc failure); im MSI braeuchte es die Util-Erweiterung. -->
        </ServiceInstall>
        <ServiceControl Id="NexusCoreServiceControl" Name="NexusCore" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
      <!-- Hilfsprogramm fuer harte Grenzen (Job Objects) -->
      <Component Id="NexusCoreJobHelper" Guid="b7e3f2a8-6d41-4c19-8a55-3f0c9e1d2b67">
        <File Id="NxjobExeFile" Source="nexuscore\helper\nxjob\target\release\nxjob.exe" KeyPath="yes" />
      </Component>
      <!-- Systray-Symbol, startet bei der Anmeldung jedes Benutzers -->
      <Component Id="NexusCoreTray" Guid="d2a94c6e-1f08-4b7d-b3e1-6a5c0f8e9d34">
        <File Id="TrayScriptFile" Source="nexuscore\scripts\nexuscore-tray.ps1" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="NexusCoreTray" Type="string"
                       Value="powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]nexuscore-tray.ps1&quot;" />
      </Component>
      <Component Id="NexusCoreEnvExample" Guid="319a3b90-1c02-4fc8-9f06-99cf80197d10">
        <File Id="EnvExampleFile" Source="nexuscore\.env.example" KeyPath="yes" />
      </Component>
      <Component Id="NexusCoreReadme" Guid="42a8b91c-7d04-4b92-91f8-08df8192a301">
        <File Id="ReadmeFile" Source="nexuscore\README.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Weboberflaeche, Spielvorlagen und Doku: der Core sucht sie neben nexuscore.exe (web, eggs, docs); die Pfade gelten ab dieser Datei -->
    <ComponentGroup Id="WebFiles" Directory="WebFolder">
      <Files Include="..\..\dist\web\**" />
    </ComponentGroup>
    <ComponentGroup Id="EggFiles" Directory="EggsFolder">
      <Files Include="..\..\..\eggs\*.json" />
    </ComponentGroup>
    <ComponentGroup Id="DocFiles" Directory="DocsFolder">
      <Files Include="..\..\docs\*.md" />
    </ComponentGroup>

    <Component Id="ProgramMenuDir" Directory="ApplicationProgramsFolder" Guid="724b0193-2940-410a-8bf6-11f87920ab32">
      <RemoveFolder Id="CleanUpProgramMenuDir" Directory="ApplicationProgramsFolder" On="uninstall" />
      <!-- "NexusCore öffnen": die Oberfläche in einem eigenen Fenster (Edge im App-Modus, ohne Adressleiste) -->
      <Shortcut Id="NexusCoreOpenShortcut"
                Directory="ApplicationProgramsFolder"
                Name="NexusCore öffnen"
                Description="Die NexusCore-Oberfläche als eigenes Fenster öffnen"
                Target="[ProgramFilesFolder]Microsoft\Edge\Application\msedge.exe"
                Arguments="--app=http://127.0.0.1:8443"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\NexusPanel\NexusCore" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Installationsfenster: Willkommen, Zielordner, Fortschrittsbalken mit Dateinamen, Fertig-Seite -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Feature Id="MainFeature" Title="NexusCore Host Daemon" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="WebFiles" />
      <ComponentGroupRef Id="EggFiles" />
      <ComponentGroupRef Id="DocFiles" />
      <ComponentRef Id="ProgramMenuDir" />
    </Feature>
  </Package>
</Wix>
